# Copie para .env e ajuste.
# 0.0.0.0 = acessível pela rede | 127.0.0.1 = só esta máquina
APP_HOST=0.0.0.0
APP_PORTA=3112

DATABASE_URL=mysql+pymysql://oficios:oficios_senha@127.0.0.1:3307/oficios?charset=utf8mb4

# Gere uma chave própria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave
JWT_EXPIRA_MINUTOS=480

UPLOAD_MAX_MB=20
DIAS_ATENCAO=30
DIAS_CRITICO=45

CORS_ORIGINS=["http://localhost:5173"]

# Login: bloqueio por alguns minutos depois de N senhas erradas seguidas (por login e computador)
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=5

# Conferência automática dos arquivos guardados (existência e hash), a cada N horas; 0 desliga
VERIFICACAO_HORAS=24
